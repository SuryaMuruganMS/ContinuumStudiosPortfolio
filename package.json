{
  "name": "continuum-studios",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Continuum Studios — a portfolio where each project deconstructs into the layers that reveal its hardest problem.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "budgets": "node scripts/check-budgets.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm run check:svelte && npm run build && npm run budgets",
    "preview:worker": "wrangler dev",
    "fonts": "python scripts/subset-fonts.py",
    "serve": "node scripts/serve-local.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.2.10",
    "svelte": "^5.57.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.131.0"
  }
}
