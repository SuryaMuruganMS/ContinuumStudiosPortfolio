# Continuum Studios — edge cache policy.
#
# Cloudflare Workers Static Assets reads this file the same way Pages did, so
# it is the one place caching is described and it ships with the build rather
# than living in a dashboard nobody can diff.

# Hashed build assets and subset fonts never change under the same name, so
# they can be held for a year and never revalidated.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Screenshots change only when the work does, and their names change with them.
/work/*
  Cache-Control: public, max-age=604800

# HTML always revalidates, so a deploy is visible on the next request rather
# than whenever a cache happens to expire.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# The commission endpoint is a Worker route, not an asset, but say it anyway:
# nothing about a form submission should ever be held anywhere.
/api/*
  Cache-Control: no-store
