# Continuum Studios — environment
#
# The site builds and runs with none of these set. They are only needed for the
# Commission Desk to actually deliver mail; without a key the endpoint still
# validates the submission and honestly reports { delivered: false } rather than
# pretending it sent.

# Resend API key. Free tier is 3,000 emails/month — https://resend.com
RESEND_API_KEY=

# Where enquiries land. Defaults to the studio address in src/lib/site.ts.
COMMISSION_TO=

# Sender. Defaults to Resend's always-verified onboarding@resend.dev, which
# works immediately. Point this at a studio address only once that domain is
# verified in Resend, or the send is rejected.
COMMISSION_FROM=
