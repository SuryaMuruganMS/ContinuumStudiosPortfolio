---
import { STRATA, type ProjectStratum } from './strata';
import Shot from '../ui/Shot.astro';

interface Props {
  stratum: ProjectStratum;
  index: number;
  active?: boolean;
}

const { stratum, index, active = false } = Astro.props;
const meta = STRATA[stratum.id];
---

<figure
  class="plane"
  class:list={[{ 'is-active': active }]}
  style={`--stratum: var(${meta.token})`}
>
  {
    stratum.image ? (
      <Shot
        src={stratum.image}
        alt={`${meta.name} layer: ${meta.shows}.`}
        label={`AxiomDSF · ${meta.name}`}
        tint={`var(${meta.token})`}
        eager={index < 2}
      />
    ) : (
      <div class="plane__placeholder" aria-hidden="true">
        <span class="mono">{meta.name}</span>
      </div>
    )
  }
  <figcaption class="plane__cap">
    <span class="plane__no mono">{String(index).padStart(2, '0')}</span>
    <span class="plane__name mono">{meta.name}</span>
    <span class="plane__note">{stratum.note}</span>
  </figcaption>
</figure>

<style>
  .plane {
    margin: 0;
    border: var(--border-hair);
    border-top: 2px solid var(--stratum);
    background: var(--ground-2);
  }
  .plane__placeholder {
    aspect-ratio: 8 / 5;
    display: grid;
    place-items: center;
    background: linear-gradient(
      160deg,
      color-mix(in oklab, var(--stratum) 14%, transparent),
      transparent 70%
    );
    color: var(--stratum);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .plane__cap {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: var(--sp-tight) var(--sp-snug);
    align-items: baseline;
    padding: var(--sp-snug) var(--sp-base);
    border-top: var(--border-hair);
  }
  .plane__no {
    font-size: 10px;
    color: var(--ink-4);
  }
  .plane__name {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stratum);
  }
  .plane__note {
    grid-column: 1 / -1;
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 52ch;
  }
</style>
