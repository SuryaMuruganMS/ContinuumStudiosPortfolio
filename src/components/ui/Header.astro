---
/**
 * Three doors in the bar, the rest behind the menu.
 *
 * It used to carry Work, Studio, Notes and a Commission button, plus a theme
 * toggle — six controls, which is what a header looks like when nobody has
 * decided what a visitor is here for. They are here for the work, and then to
 * get in touch. Everything else is real and worth keeping and belongs one
 * press away rather than in the one strip of the page that is always on
 * screen.
 *
 * The theme toggle is gone because the theme is gone: one palette, stated once
 * in tokens.css.
 */
import { SITE } from '../../lib/site';
import Sound from '../shell/Sound.astro';
import { existsSync } from 'node:fs';

interface Props {
  sticky?: boolean;
}
const { sticky = true } = Astro.props;

/**
 * The drawn four-bar glyph is the fallback, not the placeholder-to-be-deleted:
 * if no brand file has been supplied the header still has a real mark.
 *
 * One file now rather than a light/dark pair. The dark mark is the mark.
 */
const MARK = '/brand/continuum-mark-dark.webp';
const hasMark = existsSync(`public${MARK}`);
const path = Astro.url.pathname;

const NAV = [
  { href: '/', label: 'Index' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class:list={['site-head', { 'is-sticky': sticky }]}>
  <div class="site-head__inner">
    <a class="mark" href="/" aria-label={`${SITE.name} — home`}>
      {
        hasMark ? (
          <img class="mark__img" src={MARK} alt="" width="26" height="26" />
        ) : (
          <span class="mark__glyph" aria-hidden="true">
            <i style="--h: 4px; --c: var(--neon-cyan)" />
            <i style="--h: 7px; --c: var(--neon-green)" />
            <i style="--h: 11px; --c: var(--neon-orange)" />
            <i style="--h: 16px; --c: var(--ink)" />
          </span>
        )
      }
      <span class="mark__word">{SITE.short}</span>
      <span class="mark__reg" aria-hidden="true">®</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={['site-nav__link', { 'is-current': isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {/* Two copies, one clipped above the other: the hover swaps them
                rather than fading, which is the difference between a link that
                responds and a link that dims. */}
            <span class="site-nav__roll">
              <span>{item.label}</span>
              <span aria-hidden="true">{item.label}</span>
            </span>
          </a>
        ))
      }
    </nav>

    <div class="site-tools">
      <Sound />
      <button
        class="burger"
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-label="Menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
