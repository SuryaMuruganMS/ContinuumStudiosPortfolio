---
import { SITE } from '../../lib/site';

/**
 * The menu.
 *
 * Four doors, numbered, set large in the display italic — the one place on the
 * site where type is the whole design rather than a label on something else.
 * The numbering is not decoration: this is an ordered list of the ways through
 * the studio, and the order is the argument. Work first, because the work is
 * the argument; contact last, because it is what you do after you are
 * convinced.
 *
 * WHY AN OVERLAY AND NOT A PAGE
 * Three links fit in a header. Seven do not, and Continuum has seven places
 * worth going. The header keeps the three that matter on every visit and this
 * holds the rest, which means the header never has to grow a dropdown.
 *
 * FOCUS
 * Opening moves focus into the panel and traps it there; closing puts it back
 * on the button that opened it. Escape closes. This is a dialog in every
 * respect except the element, and the element is a `<div>` only because
 * `<dialog>`'s backdrop cannot be animated per-side the way this one is.
 */
const path = Astro.url.pathname;

const DOORS = [
  { href: '/', label: 'Index' },
  { href: '/projects', label: 'Projects' },
  { href: '/studio', label: 'Studio' },
  { href: '/contact', label: 'Contact' },
];

const ELSE = [
  { href: '/notes', label: 'Notes' },
  { href: '/ledger', label: 'Ledger' },
  { href: '/commission', label: 'Commission' },
  { href: '/colophon', label: 'Colophon' },
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<div class="menu" data-menu hidden>
  <div class="menu__scrim" data-menu-close></div>

  <div class="menu__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button class="menu__x" type="button" data-menu-close aria-label="Close menu">
      <span aria-hidden="true">✕</span>
    </button>

    <nav class="menu__doors" aria-label="Sections">
      <ol>
        {
          DOORS.map((d, i) => (
            <li class="menu__door" style={`--i:${i}`}>
              <a
                href={d.href}
                class:list={['menu__link', { 'is-current': isCurrent(d.href) }]}
                aria-current={isCurrent(d.href) ? 'page' : undefined}
              >
                <span class="menu__num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu__word">{d.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="menu__foot">
      <div class="menu__col">
        <p class="label">Elsewhere</p>
        <ul class="menu__else">
          {
            ELSE.map((d) => (
              <li>
                <a href={d.href} class="link-quiet">
                  {d.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="menu__col">
        <p class="label">Say hello</p>
        <a class="menu__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <p class="menu__where mono">Working with anyone, anywhere</p>
      </div>
    </div>
  </div>
</div>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  if (menu && opener) {
    const panel = menu.querySelector<HTMLElement>('.menu__panel')!;
    let open = false;

    const focusables = () =>
      [...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter(
        (el) => el.offsetParent !== null,
      );

    const set = (next: boolean) => {
      if (next === open) return;
      open = next;
      opener.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);

      if (open) {
        menu.hidden = false;
        // One frame between unhiding and marking open, or the transition has
        // nothing to transition from.
        requestAnimationFrame(() => {
          menu.dataset.on = '1';
          focusables()[0]?.focus();
        });
      } else {
        delete menu.dataset.on;
        opener.focus();
        // Hide only once the panel has actually left, so it is not pulled out
        // from under its own transition.
        const done = () => {
          if (!open) menu.hidden = true;
          panel.removeEventListener('transitionend', done);
        };
        panel.addEventListener('transitionend', done);
        setTimeout(done, 600);
      }

      dispatchEvent(new CustomEvent('cs:menu', { detail: { open } }));
    };

    opener.addEventListener('click', () => set(!open));
    for (const el of menu.querySelectorAll('[data-menu-close]')) {
      el.addEventListener('click', () => set(false));
    }

    addEventListener('keydown', (e) => {
      if (!open) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        set(false);
        return;
      }
      if (e.key !== 'Tab') return;
      // The trap. Without it, tabbing past the last link lands on browser
      // chrome and the visitor has no way back into a dialog they can see.
      const list = focusables();
      if (!list.length) return;
      const first = list[0]!;
      const last = list[list.length - 1]!;
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
