---
/**
 * The sound.
 *
 * SYNTHESISED, NOT SAMPLED.
 * The obvious build is three mp3s and an `<audio>` tag each. This is four
 * oscillators and a noise buffer, and it is smaller than the smallest useful
 * mp3 by two orders of magnitude — the whole kit is about a kilobyte of code
 * and zero bytes of download. It also tunes: a sample is whatever it was
 * recorded as, where these are notes, and the click answering the hover a
 * fifth below is why the pair feels finished rather than merely audible.
 *
 * WHAT IT SOUNDS LIKE
 * Not a click. A click is a transient and a transient on every hover is a
 * woodpecker. Each cue here is a short pitched body with a fast attack and a
 * soft tail, played quietly, low-passed, and detuned slightly at random so the
 * fourth one in a row does not sound like a machine:
 *
 *     hover   a single soft sine, 20 ms, barely there
 *     press   two sines a fifth apart, dropping a tone as they decay
 *     open    a rising third, for the menu
 *     close   the same interval falling
 *
 * OFF BY DEFAULT, AND IT STAYS OFF.
 * Autoplaying audio is the rudest thing a site can do, and browsers block it
 * anyway: an AudioContext created before a gesture starts suspended. So the
 * context is not even constructed until the visitor turns sound on, the choice
 * is remembered, and the toggle is real chrome rather than a hidden feature.
 */
---

<button
  class="snd"
  type="button"
  data-sound-toggle
  aria-pressed="false"
  title="Sound"
  data-cursor=""
>
  <span class="snd__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="visually-hidden">Sound</span>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');

  if (btn) {
    type Ctx = AudioContext & { __bus?: GainNode };
    let ctx: Ctx | null = null;
    let on = false;

    try {
      on = localStorage.getItem('cs-sound') === 'on';
    } catch {
      /* Blocked storage: start silent, which is the safe direction. */
    }

    /** Built on first use, never before — see the note above. */
    const bus = (): GainNode | null => {
      if (!ctx) {
        const C =
          window.AudioContext ??
          (window as unknown as { webkitAudioContext?: typeof AudioContext })
            .webkitAudioContext;
        if (!C) return null;
        ctx = new C() as Ctx;
        const master = ctx.createGain();
        master.gain.value = 0.5;
        // Everything goes through one gentle low-pass. Neon is a visual
        // language; the sound should be the opposite of it.
        const lp = ctx.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.value = 2400;
        master.connect(lp).connect(ctx.destination);
        ctx.__bus = master;
      }
      if (ctx.state === 'suspended') void ctx.resume();
      return ctx.__bus ?? null;
    };

    /** One pitched body: fast attack, soft exponential tail. */
    const note = (freq: number, dur: number, gain: number, glide = 0) => {
      const g = bus();
      if (!g || !ctx) return;
      const t = ctx.currentTime;
      const osc = ctx.createOscillator();
      const env = ctx.createGain();
      osc.type = 'sine';
      // A few cents of random detune, so a run of identical cues does not
      // phase into a machine.
      osc.frequency.setValueAtTime(freq * (1 + (Math.random() - 0.5) * 0.012), t);
      if (glide) osc.frequency.exponentialRampToValueAtTime(freq * glide, t + dur);
      env.gain.setValueAtTime(0.0001, t);
      env.gain.exponentialRampToValueAtTime(gain, t + 0.008);
      env.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(env).connect(g);
      osc.start(t);
      osc.stop(t + dur + 0.02);
    };

    const cue = {
      hover: () => note(660, 0.05, 0.035),
      press: () => {
        note(330, 0.16, 0.09, 0.89);
        note(495, 0.13, 0.045, 0.89);
      },
      open: () => {
        note(392, 0.18, 0.07);
        setTimeout(() => note(494, 0.22, 0.06), 55);
      },
      close: () => {
        note(494, 0.16, 0.06);
        setTimeout(() => note(392, 0.2, 0.055), 55);
      },
    };

    const paint = () => {
      btn.setAttribute('aria-pressed', String(on));
      document.documentElement.classList.toggle('snd-on', on);
    };
    paint();

    btn.addEventListener('click', () => {
      on = !on;
      try {
        localStorage.setItem('cs-sound', on ? 'on' : 'off');
      } catch {
        /* Not remembering the choice is survivable; failing to apply it is not. */
      }
      paint();
      // The toggle is itself a gesture, so this is the moment the context is
      // allowed to exist — and turning sound on should make a sound, or the
      // control appears not to work.
      if (on) cue.open();
    });

    /*
       One listener at the document rather than one per control.

       The projects grid re-renders on every filter change, so anything bound
       to a card would have to be rebound. Delegation never goes stale, and it
       costs one closest() per event.
    */
    const HOT = 'a, button, [role="button"], summary, [data-cursor]';
    let lastHover: Element | null = null;

    document.addEventListener(
      'pointerover',
      (e) => {
        if (!on) return;
        const hit = (e.target as Element | null)?.closest?.(HOT) ?? null;
        if (hit && hit !== lastHover) cue.hover();
        lastHover = hit;
      },
      { passive: true },
    );
    document.addEventListener(
      'pointerdown',
      (e) => {
        if (!on) return;
        if ((e.target as Element | null)?.closest?.(HOT)) cue.press();
      },
      { passive: true },
    );

    // The menu announces itself on the document so this file does not have to
    // know the menu exists.
    addEventListener('cs:menu', (e) => {
      if (!on) return;
      const opening = (e as CustomEvent<{ open: boolean }>).detail?.open;
      if (opening) cue.open();
      else cue.close();
    });
  }
</script>
