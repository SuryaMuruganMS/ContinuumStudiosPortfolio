---
/**
 * The cursor.
 *
 * Two parts, and they are two parts for a reason. A dot that sits exactly on
 * the pointer, so aiming is never affected — the operating system's own cursor
 * is hidden and something has to be truthful about where the click will land.
 * And a ring that lags behind it, which is the part that reads as smooth.
 *
 * The lag is a spring, not a duration. A CSS transition on `transform` gives
 * you a ring that starts late and arrives late; a per-frame lerp toward the
 * real position gives you one that is always moving toward where the pointer
 * is now, which is what the eye reads as weight. `0.16` is the coefficient:
 * high enough to keep up across a 1440px viewport, low enough that a flick
 * leaves a visible trail.
 *
 * WHAT IT REACTS TO
 * Anything focusable or pressable widens the ring and drops its opacity — the
 * ring becomes a target rather than a pointer. An element carrying
 * `data-cursor="..."` puts that word inside the ring, which is how the project
 * cards say VIEW without needing a hover overlay of their own.
 *
 * WHEN IT DOES NOT EXIST
 * Touch, coarse pointers, and reduced motion: the whole thing is skipped and
 * the native cursor is never hidden. A custom cursor on a phone is two hundred
 * bytes of nothing, and on a trackpad with reduced motion it is a smear.
 */
---

<div class="cur" aria-hidden="true" data-cursor-root hidden>
  <div class="cur__ring"><span class="cur__label"></span></div>
  <div class="cur__dot"></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-cursor-root]');
  const fine = matchMedia('(pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && fine && !still) {
    const ring = root.querySelector<HTMLElement>('.cur__ring')!;
    const dot = root.querySelector<HTMLElement>('.cur__dot')!;
    const label = root.querySelector<HTMLElement>('.cur__label')!;

    root.hidden = false;
    document.documentElement.classList.add('has-cursor');

    /** Where the pointer is, and where the ring has got to. */
    let tx = innerWidth / 2;
    let ty = innerHeight / 2;
    let rx = tx;
    let ry = ty;
    let shown = false;
    let raf = 0;

    const frame = () => {
      rx += (tx - rx) * 0.16;
      ry += (ty - ry) * 0.16;
      ring.style.transform = `translate3d(${rx.toFixed(2)}px, ${ry.toFixed(2)}px, 0) translate(-50%, -50%)`;
      dot.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0) translate(-50%, -50%)`;
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    /**
     * What is under the pointer, asked once per move rather than wired up as
     * a listener per element. The DOM here is generated from content and gets
     * re-rendered by the filter, so attaching to elements would mean
     * re-attaching every time; asking the event where it landed never goes
     * stale.
     */
    const HOT = 'a, button, [role="button"], input, select, textarea, summary, [data-cursor]';

    addEventListener(
      'pointermove',
      (e) => {
        tx = e.clientX;
        ty = e.clientY;
        if (!shown) {
          shown = true;
          root.dataset.on = '1';
        }
        const hit = (e.target as Element | null)?.closest?.(HOT) ?? null;
        const word = hit?.getAttribute('data-cursor') ?? '';
        if (label.textContent !== word) label.textContent = word;
        const state = hit ? (word ? 'word' : 'hot') : '';
        if (root.dataset.state !== state) root.dataset.state = state;
      },
      { passive: true },
    );

    // Pressing: a small, immediate squeeze, which is the one part of this that
    // must not be smoothed.
    addEventListener('pointerdown', () => (root.dataset.press = '1'), { passive: true });
    addEventListener('pointerup', () => delete root.dataset.press, { passive: true });

    /*
       WHY THIS IS NOT `pointerleave` ANY MORE.

       It was, and the cursor kept vanishing mid-page. `pointerleave` on the
       document fires whenever the pointer enters a node that is not a
       descendant of the current target — which, with a fixed canvas, a grain
       layer and a header all stacked over the content, happens constantly
       while moving normally across the page. The cursor was correctly
       responding to an event that did not mean what it looked like it meant.

       `pointerout` with no `relatedTarget` is the real "left the window"
       signal: the pointer went somewhere that is not an element in this
       document. Everything else re-shows it.

       Window blur no longer hides it either. Alt-tabbing away and back left a
       visitor with no cursor at all until they happened to move the mouse,
       and a page with no cursor looks broken rather than subtle.
    */
    document.addEventListener('pointerout', (e) => {
      if (!(e as PointerEvent).relatedTarget) delete root.dataset.on;
    });
    document.addEventListener('pointerover', () => {
      if (shown) root.dataset.on = '1';
    });

    // A scroll does not fire pointermove, so after scrolling under the cursor
    // the ring is sitting over something new and says the wrong thing. Nothing
    // reports that but the scroll itself.
    addEventListener(
      'scroll',
      () => {
        const hit = document.elementFromPoint(tx, ty)?.closest?.(HOT) ?? null;
        const word = hit?.getAttribute('data-cursor') ?? '';
        if (label.textContent !== word) label.textContent = word;
        const state = hit ? (word ? 'word' : 'hot') : '';
        if (root.dataset.state !== state) root.dataset.state = state;
      },
      { passive: true },
    );

    addEventListener('pagehide', () => cancelAnimationFrame(raf));
  }
</script>
