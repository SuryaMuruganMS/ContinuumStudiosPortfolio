---
/**
 * The fluid layer.
 *
 * Publishes four numbers on <html>, once per frame, from two listeners.
 * Everything on the site that moves reads these; nothing measures scrolling or
 * the pointer for itself.
 *
 *   --vel      signed scroll velocity, about -1 to 1
 *   --velabs   its magnitude
 *   --mx --my  pointer position, -1 to 1 from the centre of the viewport
 *
 * WHY THE CARDS BOW RATHER THAN TILT
 * The first build leaned the planes with `perspective` and `rotateX`, and that
 * was not the effect. A rectangle rotating is a rigid object; what the
 * reference site does is a sheet. Freeze their grid mid-scroll and the card
 * EDGES are curved — the top of a card arcs like a sail taking wind.
 *
 * A curved edge on a clipped box is `border-radius` with an elliptical value:
 * `50% / 5%` is an almost-straight bow, `50% / 24%` is a strong one. Driving
 * that percentage from scroll velocity gives a sheet that bellies out as the
 * page moves and flattens when it stops. One property, clipping rather than
 * warping, and nothing next to the cost of a displacement map or a mesh.
 *
 * The lean is still underneath it. Bow plus lean plus a little vertical squash
 * is the whole trick.
 *
 * REAL SCROLL IS LEFT ALONE.
 * Hijacking scrollTop breaks anchors, find-on-page, middle-drag and every
 * assistive technology. The browser scrolls exactly as it always did; a
 * smoothed copy of that position is used only to derive velocity.
 */
---

<script>
  const root = document.documentElement;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!still) {
    root.classList.add('fluid');

    let eased = window.scrollY;
    let vel = 0;
    let raf = 0;
    let idle = 0;

    /** Above this the page counts as moving and things are allowed to bend. */
    const MOVING = 0.01;

    // Chased, not followed: an abrupt parallax reads as the whole page
    // snapping sideways rather than as depth.
    let px = 0;
    let py = 0;
    let mx = 0;
    let my = 0;

    const frame = () => {
      const target = window.scrollY;
      const prev = eased;
      eased += (target - eased) * 0.12;

      // The divisor is what "fast" means. At half a viewport an ordinary wheel
      // scroll came out at 0.12, which multiplied through to under a degree of
      // bend — mathematically present and visually absent. A fifth puts a
      // normal scroll near 0.35 and a trackpad fling at the clamp.
      const raw = (eased - prev) / (innerHeight * 0.2);
      vel += (raw - vel) * 0.3;
      const clamped = Math.max(-1, Math.min(1, vel));
      const mag = Math.abs(clamped);

      root.style.setProperty('--vel', clamped.toFixed(4));
      root.style.setProperty('--velabs', mag.toFixed(4));

      mx += (px - mx) * 0.055;
      my += (py - my) * 0.055;
      root.style.setProperty('--mx', mx.toFixed(4));
      root.style.setProperty('--my', my.toFixed(4));

      // Past the header's own height the bar needs its scrim, because from
      // here down there is always something underneath it.
      if (target > 24) root.setAttribute('data-scrolled', '');
      else root.removeAttribute('data-scrolled');

      const drifting = Math.abs(px - mx) > 0.002 || Math.abs(py - my) > 0.002;

      if (mag > MOVING) {
        idle = 0;
        if (!root.hasAttribute('data-moving')) root.setAttribute('data-moving', '');
      } else {
        idle++;
        // Half a second of stillness before the page is declared still, so a
        // scroll that pauses mid-gesture does not snap flat and start again.
        if (idle > 30 && root.hasAttribute('data-moving')) {
          root.removeAttribute('data-moving');
          root.style.setProperty('--vel', '0');
          root.style.setProperty('--velabs', '0');
        }
      }

      // The loop keeps going while the parallax is still catching up, then
      // stops. A permanently running rAF on a static page is a battery bug.
      if (idle > 90 && !drifting) {
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(frame);
    };

    const kick = () => {
      idle = 0;
      if (!raf) raf = requestAnimationFrame(frame);
    };

    addEventListener('scroll', kick, { passive: true });
    addEventListener('resize', kick, { passive: true });
    addEventListener(
      'pointermove',
      (e) => {
        px = (e.clientX / innerWidth) * 2 - 1;
        py = (e.clientY / innerHeight) * 2 - 1;
        kick();
      },
      { passive: true },
    );
    kick();

    /*
       REVEAL.

       Every fluid section rises and un-blurs once, when it first crosses into
       view. An IntersectionObserver rather than a scroll calculation: one
       callback per element for the life of the page, instead of a measurement
       per element per frame.
    */
    const targets = document.querySelectorAll<HTMLElement>('[data-flow]');
    if (targets.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.setAttribute('data-in', '');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
      );
      for (const t of targets) io.observe(t);
    } else {
      for (const t of targets) t.setAttribute('data-in', '');
    }
  } else {
    for (const t of document.querySelectorAll('[data-flow]')) t.setAttribute('data-in', '');
  }
</script>
