---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Dust from '../../components/projects/Dust.astro';
import '../../styles/projects.css';

/**
 * Projects.
 *
 * ONE PER ROW, NOT TWO PER LINE.
 * The first build was a two-column offset grid, which is the shape every
 * studio index has and the right shape for twenty projects. With four it is a
 * table with a gap in it, and every card is small enough that the work inside
 * it is a thumbnail rather than a picture. Stacked, each project gets the full
 * width of the page: the media is large enough to actually read, and there is
 * room beside it for the things that make somebody click — what it is, who it
 * was for, what was hard, and what came out.
 *
 * THE FILTER SORTS IT THE WAY A VISITOR THINKS.
 * It used to filter by discipline. "Show me the cartography ones" is a
 * question another designer asks; "is this for a public body or a product
 * team" is the question somebody arriving actually has. Four sectors, and
 * below them the row nobody else can offer — filter by the layer a project
 * exposes.
 *
 * EVERY CARD IS IN THE HTML.
 * The reference site draws its grid into a WebGL canvas, which buys a
 * beautiful dissolve and costs it the entire document: no headings, no links,
 * nothing for a crawler or a screen reader. Here the rows are real markup that
 * work with scripting off; the filter toggles an attribute and CSS reacts to
 * it.
 */
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const SECTORS = ['Government', 'Private', 'Software', 'Portfolio'] as const;
const sectorsUsed = SECTORS.filter((s) => work.some((w) => w.data.sector === s));
const strataUsed = [...new Set(work.flatMap((w) => w.data.strata.map((s) => s.id)))].sort();

/**
 * The frames, and how each one is cropped.
 *
 * These are screenshots of websites, and a website screenshot cropped from the
 * centre shows the middle of a page — which is body copy, every time. The
 * interesting part is the top, so `pos` is a CSS `object-position` per image
 * and it defaults to the top edge rather than the centre. Three of them are
 * different: Kestrel's hero is a full-bleed photograph and reads better
 * centred, and the two maps are square-ish crops whose subject is the middle.
 *
 * A presentation choice rather than content, so it stays out of the entry
 * frontmatter.
 */
interface Frame {
  rest: string;
  hover?: string;
  pos?: string;
  hoverPos?: string;
}
const FRAMES: Record<string, Frame> = {
  istanmetro: {
    rest: '/work/istanmetro/01-hero-night.webp',
    hover: '/work/istanmetro/04-map-world.webp',
    pos: '50% 0%',
    hoverPos: '50% 50%',
  },
  'kestrel-offshore': {
    rest: '/work/kestrel/00-hero-descent.webp',
    hover: '/work/kestrel/06-live-seabed.webp',
    pos: '50% 30%',
    hoverPos: '50% 50%',
  },
  'axiom-dsf': {
    rest: '/work/axiom/06-live-console.webp',
    hover: '/work/axiom/05-motion-runs.webp',
    pos: '50% 0%',
    hoverPos: '50% 0%',
  },
  // roshan-portfolio deliberately has none: it is in progress, and a cover
  // would make an unfinished project look finished.
};

const count = (pred: (w: (typeof work)[number]) => boolean) => work.filter(pred).length;
---

<Base
  title="Projects — Continuum Studios"
  description="Four projects, taken apart. Filter by who the work was for, or by the layers it exposes."
>
  <div class="room room--projects">
    <Dust density={64} />

    <section class="pj">
      <header class="pj__head" data-flow>
        <p class="pj__eyebrow mono">
          Selected work <span class="pj__n">{String(work.length).padStart(2, '0')}</span>
        </p>

        <h1 class="pj__title">
          <span class="pj__title-a">Four projects,</span>
          <span class="pj__title-b">taken apart.</span>
        </h1>

        <p class="pj__lede">
          Every one comes apart into the layers that reveal its hardest problem. Filter by who
          it was for, or by the layer you want to see.
        </p>
      </header>

      <div class="pj__filters" data-filters data-flow>
        <div class="fbar" role="group" aria-label="Filter by sector">
          <span class="fbar__k mono">Made for</span>
          <button class="pill is-on" type="button" data-f="all" aria-pressed="true">
            Everything <sup class="mono">{work.length}</sup>
          </button>
          {
            sectorsUsed.map((s) => (
              <button
                class="pill"
                type="button"
                data-f="sector"
                data-v={s}
                aria-pressed="false"
              >
                {s} <sup class="mono">{count((w) => w.data.sector === s)}</sup>
              </button>
            ))
          }
        </div>

        <div class="fbar" role="group" aria-label="Filter by exposed layer">
          <span class="fbar__k mono">Exposes a layer</span>
          {
            strataUsed.map((s) => (
              <button
                class="pill pill--s"
                type="button"
                data-f="stratum"
                data-v={s}
                aria-pressed="false"
                style={`--s: var(--s-${s})`}
              >
                <i class="pill__dot" aria-hidden="true" />
                {s}{' '}
                <sup class="mono">{count((w) => w.data.strata.some((x) => x.id === s))}</sup>
              </button>
            ))
          }
        </div>

        <p class="pj__tally mono" data-tally aria-live="polite">
          Showing {work.length} of {work.length}
        </p>
      </div>

      <ol class="prow" data-grid>
        {
          work.map((w, i) => {
            const f = FRAMES[w.id];
            return (
              <li
                class="prow__item"
                style={`--i:${i}`}
                data-sector={w.data.sector}
                data-strata={w.data.strata.map((s) => s.id).join('|')}
                data-flow
              >
                <article class="prj">
                  {/* The media leads on odd rows and follows on even ones, so
                      the eye crosses the page rather than running down one
                      side of it. Order is set in CSS, not markup: the reading
                      order stays picture-then-words at every width. */}
                  <a class="prj__media flow" href={`/work/${w.id}`} data-cursor="Open">
                    <span class="prj__frame">
                      {f ? (
                        <>
                          <img
                            class="prj__img flow__media"
                            src={f.rest}
                            alt=""
                            style={`object-position:${f.pos ?? '50% 0%'}`}
                            loading={i === 0 ? 'eager' : 'lazy'}
                            decoding="async"
                          />
                          {f.hover && (
                            <img
                              class="prj__img prj__img--hover flow__media"
                              src={f.hover}
                              alt=""
                              style={`object-position:${f.hoverPos ?? '50% 0%'}`}
                              loading="lazy"
                              decoding="async"
                            />
                          )}
                        </>
                      ) : (
                        <span class="prj__none mono">In progress</span>
                      )}
                      <span class="prj__sweep" aria-hidden="true" />
                    </span>
                  </a>

                  <div class="prj__side">
                    <p class="prj__idx mono">
                      <span>{String(i + 1).padStart(2, '0')}</span>
                      <span class="prj__sector">{w.data.sector}</span>
                      <span>{w.data.year}</span>
                    </p>

                    <h2 class="prj__title">
                      <a href={`/work/${w.id}`}>{w.data.title}</a>
                    </h2>

                    <p class="prj__problem">{w.data.problem}</p>

                    <dl class="prj__facts">
                      <div>
                        <dt class="label">Did</dt>
                        <dd>{w.data.disciplines.join(', ')}</dd>
                      </div>
                      {w.data.metrics?.[0] && (
                        <div>
                          <dt class="label">{w.data.metrics[0].label}</dt>
                          <dd class="prj__fig">{w.data.metrics[0].after}</dd>
                        </div>
                      )}
                    </dl>

                    <ul class="prj__strata" aria-label="Layers exposed">
                      {w.data.strata.map((s) => (
                        <li style={`--s: var(--s-${s.id})`}>{s.id}</li>
                      ))}
                    </ul>

                    <p class="prj__acts">
                      <a class="prj__go" href={`/work/${w.id}`}>
                        <span>Take it apart</span>
                        <span class="prj__go-rule" aria-hidden="true" />
                      </a>
                      {w.data.liveUrl && (
                        <a
                          class="prj__live link-quiet"
                          href={w.data.liveUrl}
                          rel="noopener"
                          target="_blank"
                        >
                          Live site ↗
                        </a>
                      )}
                    </p>
                  </div>
                </article>
              </li>
            );
          })
        }
      </ol>

      <p class="pj__empty" data-empty hidden>
        Nothing exposes that layer yet.
        <button type="button" data-reset>Show all four</button>
      </p>
    </section>
  </div>
</Base>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const tally = document.querySelector<HTMLElement>('[data-tally]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (grid && bar) {
    const rows = [...grid.querySelectorAll<HTMLElement>('.prow__item')];
    const pills = [...bar.querySelectorAll<HTMLButtonElement>('.pill')];
    const total = rows.length;

    /**
     * One filter at a time, and "everything" is a filter.
     *
     * Multi-select was the first build and it was wrong: with four projects,
     * any two conditions land on zero results, so the interface spent most of
     * its life showing an empty state. One at a time always shows something,
     * and the counts on the pills say what each one will give you before you
     * press it.
     */
    let kind: 'all' | 'sector' | 'stratum' = 'all';
    let value = '';

    const apply = () => {
      let shown = 0;
      for (const row of rows) {
        const on =
          kind === 'all' ||
          (kind === 'sector'
            ? row.dataset.sector === value
            : (row.dataset.strata ?? '').split('|').includes(value));
        if (on) shown++;
        row.toggleAttribute('data-out', !on);
      }

      // The stagger is re-indexed over what is actually visible, so a filter
      // that leaves rows 1 and 4 animates them as first and second rather than
      // first and fourth — otherwise the second arrives a long beat late for
      // no reason a reader can see.
      let n = 0;
      for (const row of rows) {
        if (!row.hasAttribute('data-out')) row.style.setProperty('--i', String(n++));
      }

      if (tally) tally.textContent = `Showing ${shown} of ${total}`;
      if (empty) empty.hidden = shown > 0;
    };

    const paint = (active: HTMLButtonElement | null) => {
      for (const p of pills) {
        const on = p === active;
        p.classList.toggle('is-on', on);
        p.setAttribute('aria-pressed', String(on));
      }
    };

    bar.addEventListener('click', (e) => {
      const pill = (e.target as HTMLElement).closest<HTMLButtonElement>('.pill');
      if (!pill) return;
      const f = pill.dataset.f as typeof kind | undefined;
      if (!f) return;
      kind = f;
      value = pill.dataset.v ?? '';
      paint(pill);
      apply();
    });

    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      kind = 'all';
      value = '';
      paint(pills[0] ?? null);
      apply();
    });
  }
</script>
